<%# One place for the messages a redirect leaves behind (connect-flash): errors, notices, successes. %>
<% if (flash && flash.error) { %><div data-flash-error role="alert" class="p-3 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-xl text-red-700 dark:text-red-300 text-sm"><%= flash.error %></div><% } %>
<% if (flash && flash.info) { %><div role="status" class="p-3 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded-xl text-amber-800 dark:text-amber-200 text-sm"><%= flash.info %></div><% } %>
<% if (flash && flash.success) { %><div role="status" class="p-3 bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 rounded-xl text-emerald-800 dark:text-emerald-200 text-sm"><%= flash.success %></div><% } %>
